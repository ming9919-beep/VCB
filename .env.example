# 第三方户名查询（BankLookup）凭据，请配置在本机的 .env.local 中。
# 获取方式：注册 https://banklookup.net → 控制台 → API Key
BANKLOOKUP_API_KEY=
BANKLOOKUP_API_SECRET=
# 设为 1 使用不计费的 Sandbox：不消耗 credit，返回模拟户名（仍需真实密钥）。
# 测试/演示环境建议设为 1；充值 credit 并需要真实户名时清空此项。
BANKLOOKUP_SANDBOX=

# VietQR Reader API base URL; defaults to the locally running API service.
VIETQR_READER_BASE_URL=http://127.0.0.1:8000

# Local demo credentials only. Do not use real banking credentials here.
VITE_DEMO_USERNAME=
VITE_DEMO_PHONE=
VITE_DEMO_LOGIN_PASSWORD=
VITE_DEMO_PAYMENT_PASSWORD=
